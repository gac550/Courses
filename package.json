{
  "name": "courses",
  "version": "0.1.0",
  "description": "Catálogo verificable y autoactualizable de cursos gratuitos de universidades y organismos de primer nivel",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "discover": "node scripts/discover.mjs",
    "crawl": "node scripts/crawl.mjs",
    "extract": "node scripts/extract.mjs",
    "verify": "node scripts/verify.mjs",
    "update": "node scripts/update.mjs",
    "validate": "node scripts/validate.mjs",
    "check-links": "node scripts/check-links.mjs",
    "stats": "node scripts/stats.mjs",
    "diff": "node scripts/diff.mjs",
    "build-db": "node scripts/build-db.mjs",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {}
}
