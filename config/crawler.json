{
  "userAgent": "CoursesCatalogBot/0.1 (+catalogo educativo verificable; contacto via repositorio)",
  "concurrency": {
    "global": 5,
    "perHost": 2
  },
  "delayMsPerHost": 1500,
  "timeoutMs": 15000,
  "maxDepth": 3,
  "maxPagesPerSource": 300,
  "retries": {
    "max": 2,
    "backoffMs": 2000,
    "backoffFactor": 2
  },
  "respectRobotsTxt": true,
  "followRedirects": true,
  "maxRedirects": 5,
  "skipExtensions": [
    ".pdf", ".zip", ".tar", ".gz", ".mp4", ".mp3", ".avi", ".mov",
    ".png", ".jpg", ".jpeg", ".gif", ".svg", ".ico", ".css", ".js",
    ".woff", ".woff2", ".ttf", ".eot", ".xml", ".rss"
  ],
  "skipUrlPatterns": [
    "/login", "/signin", "/sign-in", "/register", "/signup", "/checkout",
    "/cart", "/account", "/profile", "/password", "/logout", "/admin",
    "/search?", "/print/", "/share", "facebook.com", "twitter.com",
    "linkedin.com", "instagram.com", "youtube.com/watch"
  ],
  "verificationMaxAgeDays": 90
}
